# ============================================================================
# Job-Reach Environment Configuration (.env.example)
# Copy this file to .env and fill in your credentials before live execution.
# ============================================================================

# --- Dual Enrichment API Keys (Free-Tier Failover) ---
# Both keys remain active. The EnrichmentFailoverRouter uses the primary provider
# first and automatically fails over to the secondary provider on HTTP 429 or
# free-tier credit exhaustion, including cross-provider Name+Domain handoff.
APOLLO_API_KEY=your_apollo_free_tier_api_key_here
HUNTER_API_KEY=your_hunter_free_tier_api_key_here

# Optional override for primary enrichment provider ("apollo" or "hunter")
ENRICHMENT_PRIMARY_PROVIDER=apollo

# --- Candidate Profile ---
CANDIDATE_NAME=Alex Rivera
CANDIDATE_EMAIL=alex.rivera@example.com
CANDIDATE_PHONE=+91-9876543210
CANDIDATE_PORTFOLIO_URL=https://github.com/alexrivera
CANDIDATE_LINKEDIN_URL=https://www.linkedin.com/in/alexrivera
CANDIDATE_RESUME_PATH=assets/resume.pdf

# --- Mail Transport Selection ("smtp" or "gmail_oauth") ---
MAIL_TRANSPORT=smtp

# Option A: Gmail App Password over SMTP TLS (smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alex.rivera@example.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Option B: Gmail API OAuth2 Credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# --- Optional LLM Personalization Hook (leave blank for deterministic Jinja2) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Optional LinkedIn Session Cookie for Authenticated Scraping ---
LINKEDIN_LI_AT_COOKIE=

# --- SQLite State Database Path ---
JOB_REACH_DB_PATH=job_reach_state.db
